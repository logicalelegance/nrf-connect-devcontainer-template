// Run with Run and Debug (F5). Each configuration builds first.
{
  "version": "0.2.0",
  "configurations": [
    {
      // Runs the app as a program inside the container: breakpoints, stepping, variables.
      // No hardware needed; anything touching real peripherals is simulated.
      "name": "Debug on native_sim",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build (native_sim)",
      "program": "${workspaceFolder}/build-sim/app/zephyr/zephyr.exe",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb-multiarch"
    },
    {
      // Debugs the board through a J-Link connected to the Mac. First, on the Mac (not in the
      // container), start the GDB server:  scripts/jlink-gdb-server.sh [J-Link device name]
      // Builds whatever board build/ was last built for, loads it, and runs to your breakpoints.
      "name": "Debug on device (J-Link on the Mac)",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build (current board)",
      "program": "${workspaceFolder}/build/app/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
      "miDebuggerServerAddress": "host.docker.internal:2331",
      "postRemoteConnectCommands": [
        { "text": "monitor reset" },
        { "text": "load" },
        { "text": "monitor reset" }
      ]
    }
  ]
}

// Run with Run and Debug (F5). Each configuration builds first.
{
  "version": "0.2.0",
  "configurations": [
    {
      // Runs the app as a program inside the container: breakpoints, stepping, variables.
      // No hardware needed; anything touching real peripherals is simulated.
      "name": "Debug on native_sim",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build (native_sim)",
      "program": "${workspaceFolder}/build-sim/app/zephyr/zephyr.exe",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb-multiarch"
    },
    {
      // Debugs the board through a J-Link connected to the Mac. First, on the Mac (not in the
      // container), start the GDB server:  scripts/jlink-gdb-server.sh [J-Link device name]
      // Builds for the board in board.env, loads it and stops at main().
      // Cortex-Debug adds peripheral registers, memory, disassembly and live watch views;
      // build with debug.conf to see Zephyr threads.
      "name": "Debug on device",
      "type": "cortex-debug",
      "request": "launch",
      "preLaunchTask": "Build",
      "executable": "${workspaceFolder}/build/app/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "servertype": "external",
      "gdbTarget": "host.docker.internal:2331",
      "gdbPath": "/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
      "armToolchainPath": "/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin",
      "toolchainPrefix": "arm-zephyr-eabi",
      "overrideLaunchCommands": ["monitor reset", "load", "monitor reset"],
      "runToEntryPoint": "main",
      // Chip register descriptions; scripts/build.sh links the SVD for the chip being built.
      "svdFile": "${workspaceFolder}/build/board.svd"
    }
  ]
}

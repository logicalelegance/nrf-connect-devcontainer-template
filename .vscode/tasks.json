// Run with Terminal > Run Task (Build is also Cmd+Shift+B). Same commands as the README.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "scripts/build.sh",  // board from board.env
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (native_sim)",
      "type": "shell",
      "command": "west build -b native_sim/native/64 -d build-sim .",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "west twister -T tests -p native_sim/native/64 --outdir twister-out",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      // Shows console/log output sent over the J-Link (build with rtt.conf; GDB server running).
      "label": "RTT console",
      "type": "shell",
      "command": "bash -c 'cat < /dev/tcp/host.docker.internal/19021'",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "rm -rf build build-sim twister-out",
      "problemMatcher": []
    }
  ]
}

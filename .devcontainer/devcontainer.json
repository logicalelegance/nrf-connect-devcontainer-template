// VS Code dev container: the same image as the command line and CI, built locally
// from docker/Dockerfile. After changing west.yml, run "Dev Containers: Rebuild Container".
{
  "name": "nRF Connect SDK",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": ".."
  },

  // The repo is mounted inside the NCS workspace that is baked into the image.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workdir/app,type=bind",
  "workspaceFolder": "/workdir/app",
  "remoteUser": "dev",

  "customizations": {
    "vscode": {
      // Nordic's nRF Connect extension brings nrf-devicetree, nrf-kconfig and nrf-terminal.
      // It finds the SDK and Zephyr SDK baked into the image ("third party" in its panel).
      // Nordic doesn't officially support it in containers; tested OK on 2026-10-05.
      "extensions": [
        "ms-vscode.cpptools",               // C/C++ IntelliSense
        "nordic-semiconductor.nrf-connect", // build panel, Kconfig GUI/hover, Devicetree editor
        "marus25.cortex-debug"              // "Debug on device (Cortex-Debug)": registers, memory views
      ],
      "settings": {
        // Generated by every build; gives IntelliSense the exact Zephyr include paths and defines.
        "C_Cpp.default.compileCommands": "${workspaceFolder}/build/app/compile_commands.json",

        // Don't run Nordic's local AI (MCP) server in the container unless someone opts in.
        "nrf-connect.mcp.local.enabled": false
      }
    }
  }
}

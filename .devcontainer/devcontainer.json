// VS Code dev container: the same image as the command line and CI, built locally
// from docker/Dockerfile. After changing west.yml, run "Dev Containers: Rebuild Container".
{
  "name": "nRF Connect SDK",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": ".."
  },

  // The repo is mounted inside the NCS workspace that is baked into the image.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workdir/app,type=bind",
  "workspaceFolder": "/workdir/app",
  "remoteUser": "dev",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",           // C/C++ IntelliSense
        "KyleMicallefBonnici.dts-lsp",  // Devicetree (.dts, .overlay) language server
        "trond-snekvik.kconfig-lang"    // Kconfig and prj.conf; finds Zephyr through west by itself
      ],
      "settings": {
        // Generated by every build; gives IntelliSense the exact Zephyr include paths and defines.
        "C_Cpp.default.compileCommands": "${workspaceFolder}/build/app/compile_commands.json",

        // Where the devicetree includes and bindings live in the NCS workspace.
        "devicetree.cwd": "/workdir",
        "devicetree.defaultBindingType": "Zephyr",
        "devicetree.defaultIncludePaths": [
          "./zephyr/dts", "./zephyr/dts/arm", "./zephyr/dts/common", "./zephyr/dts/vendor",
          "./zephyr/include", "./nrf/dts", "./nrf/dts/common"
        ],
        "devicetree.defaultZephyrBindings": ["./zephyr/dts/bindings", "./nrf/dts/bindings"]
      }
    }
  }
}
